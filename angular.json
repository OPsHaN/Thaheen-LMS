{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "projects": {
    "thaheen": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "polyfills": ["zone.js"],
            "tsConfig": "tsconfig.json",
            "index": "src/index.html",
            "styles": ["src/styles.css"],
            "assets": [{ "glob": "**/*", "input": "src/assets", "output": "assets" }]
          },
          "configurations": {
            "production": {
              "outputHashing": "all",
              "budgets": [{ "type": "initial", "maximumWarning": "600kB", "maximumError": "1MB" }]
            },
            "development": { "optimization": false, "sourceMap": true, "extractLicenses": false }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": { "host": "localhost", "port": 3000 },
          "configurations": {
            "development": { "buildTarget": "thaheen:build:development" },
            "production": { "buildTarget": "thaheen:build:production" }
          },
          "defaultConfiguration": "development"
        }
      }
    }
  },
  "cli": {
    "analytics": "17865ae1-f994-4d3f-963a-930e848ed87e"
  }
}
